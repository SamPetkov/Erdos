% Common, readable AMS preprint layout. Mathematics and metadata stay paper-local.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{petkov-preprint}[2026/10/12 Consistent readable AMS preprints]
\RequirePackage[a4paper,margin=24mm]{geometry}
\RequirePackage[T1]{fontenc}
\RequirePackage{amsmath}
\RequirePackage{newtxtext,newtxmath}
\RequirePackage{microtype}
\RequirePackage{enumitem}
\RequirePackage{needspace}
\RequirePackage{etoolbox}
\RequirePackage{xurl}
\RequirePackage{xcolor}
\definecolor{InternalLink}{HTML}{245B9D}
\definecolor{CitationLink}{HTML}{007B70}
\definecolor{ExternalLink}{HTML}{8F384A}
% Compatibility names for existing manuscript-local hyperref metadata blocks.
\colorlet{paperLink}{InternalLink}
\colorlet{paperCite}{CitationLink}
\colorlet{paperURL}{ExternalLink}
\RequirePackage[pdfencoding=auto,psdextra]{hyperref}
\hypersetup{colorlinks=true,linkcolor=InternalLink,
  citecolor=CitationLink,urlcolor=ExternalLink,pdfdisplaydoctitle=true}
\RequirePackage{bookmark}
\RequirePackage{fancyhdr}
\setlength{\parindent}{1.5em}
\setlength{\parskip}{0pt}
\setlength{\emergencystretch}{3em}
\setlist[itemize]{leftmargin=2em,itemsep=0.12em,topsep=0.35em}
\setlist[enumerate]{leftmargin=2.2em,itemsep=0.12em,topsep=0.35em}
\allowdisplaybreaks[2]
\raggedbottom
\Urlmuskip=0mu plus 1mu
\frenchspacing
\tolerance=1800
\pretolerance=500
\ifdefined\pdfgentounicode\pdfgentounicode=1\fi
\providecommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}
% The AMS environment resets its font after a simple AtBeginEnvironment hook.
\makeatletter
\@ifclassloaded{amsart}{%
  \patchcmd{\abstract}{\normalfont\Small}{\normalfont\normalsize}
    {}{\PackageError{petkov-preprint}{AMS abstract font patch failed}
      {Check the installed amsart abstract definition.}}
  \patchcmd{\abstract}{\leftmargin3pc}{\leftmargin2pc}
    {}{\PackageError{petkov-preprint}{AMS abstract width patch failed}
      {Check the installed amsart abstract definition.}}
}{\PackageError{petkov-preprint}{This style requires the amsart class}
  {Use documentclass[a4paper,11pt,reqno]{amsart}.}}
\makeatother
% Outside body-size folios on every page, including the AMS title page.
\pagestyle{fancy}
\fancyhf{}
\fancyfoot[LE,RO]{\normalfont\normalsize\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\setlength{\footskip}{24pt}
\fancypagestyle{firstpage}{%
  \fancyhf{}
  \fancyfoot[LE,RO]{\normalfont\normalsize\thepage}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}}
\endinput
