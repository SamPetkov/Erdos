    calc (7 / 5 : ℝ) * ((n : ℝ) * ell ^ 2 / L ^ 2)
        = ((7 / 5 : ℝ) * L ^ 2) * ((n : ℝ) * ell ^ 2 / L ^ 4) := by
          field_simp [hL_pos.ne']
      _ ≤ (q / 4 * (phaseNat n : ℝ) ^ 2) * (r - (k_star : ℝ)) :=
          mul_le_mul hslope_7_5 (by linarith only [hk_cast, hfl_le, hsh_th_ge])
