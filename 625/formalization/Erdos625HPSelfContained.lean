          (b.descFactorial (min a b) : ENNReal) /
            ((min a b).factorial : ENNReal)) =
        ((min a b).factorial : ENNReal) *
          (Nat.choose (max a b) (max a b - min a b) : ENNReal) := by
    wlog h : a ≤ b generalizing a b
    · rw [min_comm, max_comm, mul_comm]
