  have hl2 : |cappedDualValue Sge1 thetaBar T -
      cappedDualValue Sge1 thetaBar (phaseTarget (phaseDelta n))| ≤
      2 * C_wide * universalDualLip_v12 * ell / L := by
    calc |cappedDualValue Sge1 thetaBar T -
