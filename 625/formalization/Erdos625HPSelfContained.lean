theorem tendsto_mean_of_scores_and_parameter
    {A : Type*} {l : Filter A}
    (h : A → Fin 4 → ℝ) (g : Fin 4 → ℝ)
    (t : A → ℝ) (t₀ : ℝ)
    (hscores : ∀ i, Tendsto (fun a ↦ h a i) l (nhds (g i)))
