  have hGap : 0 ≤ b - ∫ omega, X omega ∂mu := sub_nonneg.mpr hExpectation
  have _hSeedMeasurable : MeasurableSet {omega | X omega = b} :=
    measurableSet_eq_fun hXMeasurable measurable_const
