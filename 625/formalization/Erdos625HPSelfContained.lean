              (1 / 2 : ℝ) ^ ((u - r_out) * r_out) ≤
            (α : ℝ) ^ (M + 1 + R_max) * Real.exp (-(3 / 2 : ℝ) * L) := by
        calc (B_star.card.choose (u - r_out) : ℝ) *
                (((Finset.univ : Finset (Fin n)) \ B_star).card.choose r_out : ℝ) *
