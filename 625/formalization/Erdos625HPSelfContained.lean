                            ((n : ℝ) / (Real.log (n : ℝ)) ^ 3)| ≤
                          K_sep * (n : ℝ) * Real.log (Real.log (n : ℝ)) / (Real.log (n : ℝ)) ^ 4) := by
  obtain ⟨K_slope, hK_slope_pos, hSlopeEv⟩ := eventually_unrestrictedPhaseObjective_deriv_logLogRate C hC
  obtain ⟨Mtilt, hMtilt_nn, huniformTilt⟩ :=
