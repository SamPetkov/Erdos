    constructor;
    · intro a
      have h_card : (Finset.filter (fun e => e.1 = a) D).card = (p.toSubgraph.neighborSet (Sum.inl a)).ncard := by
        rw [ ← Set.ncard_coe_finset ];
        fapply Set.ncard_congr;
        use fun e he => Sum.inr e.2;
        · simp +zetaDelta at *;
