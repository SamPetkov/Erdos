  have hu_card : ((Finset.Icc (α - (M + 1)) α).card : ℝ) ≤ ((M + 2 : ℕ) : ℝ) := by
    rw [Nat.card_Icc]
    exact_mod_cast (show α + 1 - (α - (M + 1)) ≤ M + 2 by omega)
