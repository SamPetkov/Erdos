theorem eventually_uniform_optimizer_pos_on_compact
    (h : ℕ → Fin 4 → ℝ) (g : Fin 4 → ℝ) (K : Set ℝ)
    (hKcompact : IsCompact K)
    (hKinterior : K ⊆ Set.Ioo (2 : ℝ) 5)
    (huniform : ∀ ε > 0, ∃ N : ℕ, ∀ n ≥ N, ∀ i, |h n i - g i| < ε) :
