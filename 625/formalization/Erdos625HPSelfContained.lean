    (randomGraphMeasure n).real
        (partitionColoringEvent P ∩ bad2Event_v12 M (Nat.floor ((logLogOrder n) ^ 2)) P) ≤
      (eps / 4) * (randomGraphMeasure n).real (partitionColoringEvent P) := by
