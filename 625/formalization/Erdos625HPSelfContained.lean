      2 * (C_dual * ell / L) + 2 * (2 * C_wide * universalDualLip_v12 * ell / L) + ell / L := by
    rw [hC_err_def]; ring
  have e1 : |cappedInfiniteFiniteEntropy (phaseNat n) p_1 T - cappedDualValue Sge1 p_1 T| ≤
