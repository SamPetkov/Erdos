  have hchooseNat : Nat.choose m e ≤ m ^ e := Nat.choose_le_pow m e
  have hchoose : (Nat.choose m e : ENNReal) ≤ (m : ENNReal) ^ e := by
    exact_mod_cast hchooseNat
  have hdiv :
