  set main_term : ℝ := (Real.log 2) ^ 2 / 4 * Δ_main * ((n : ℝ) / L ^ 3)
  have hS₀_mul_main : S₀ * main_term = r₀ * Δ_main := by
    dsimp [S₀, main_term, r₀]
    field_simp [hq_pos.ne', hL_pos.ne']
