      midpointPartialDiagonalY, ← hk]
    rw [Finset.sum_sub_distrib, ← Finset.sum_div, ← Finset.sum_div,
      ← Nat.cast_sum, ← Nat.cast_sum, hsum, ← hL]
    field_simp
