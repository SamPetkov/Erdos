  have htop_lt_k : kp ⟨phaseNat n - 1 - 1, by omega⟩ < k_star := by
    suffices (kp ⟨phaseNat n - 1 - 1, by omega⟩ : ℝ) < (k_star : ℝ) from Nat.cast_lt.mp this
    have hth_le1 : thetaBar ≤ 1 := htheta_hi.trans (by norm_num)
