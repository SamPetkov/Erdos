      gapScale n = gapConstant * baseScale n := by
    simp only [gapScale, baseScale]
    ring
  calc
    gapScale n = gapConstant * baseScale n := hScaleIdentity
    _ ≤ (kChi n : ℝ) - (kCo n : ℝ) - a n := hCore
