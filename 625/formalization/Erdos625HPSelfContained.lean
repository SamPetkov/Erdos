  let rowAllocation : ∀ a, StubAllocation (row a) (demand a) := fun a ↦
    ⟨selected a, by
      constructor
      · exact hcard a
      · intro b b' hne
        rw [Finset.disjoint_left]
        intro stub hs hs'
        have hb := hsubset a b hs
        have hb' := hsubset a b' hs'
        simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hb hb'
        exact hne (hb.symm.trans hb')⟩
