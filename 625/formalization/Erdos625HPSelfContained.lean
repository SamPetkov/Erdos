  have hn_pos : (0 : ℝ) < (n : ℝ) := by positivity
  have hn1_real : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast (show 1 ≤ n by omega)
  have hα_ge1 : (1 : ℝ) ≤ (α : ℝ) := by exact_mod_cast (show 1 ≤ α by omega)
