        _ = Real.exp (2 * δ) * (Real.exp (l * (i : ℝ) + sc₂ i) / wPart_v13 W sc₂ l) := by
            have h1 : Real.exp (2 * δ) = Real.exp δ / Real.exp (-δ) := by
              rw [← Real.exp_sub]; congr 1; ring
            rw [h1]; field_simp [(Real.exp_pos _).ne', hZ₂.ne']
