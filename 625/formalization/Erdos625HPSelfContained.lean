    have hsq : (i : ℝ) ^ 2 ≤ ((1 + M : ℕ) : ℝ) ^ 2 :=
      pow_le_pow_left₀ (Nat.cast_nonneg i) (by exact_mod_cast (show i ≤ 1 + M by omega)) 2
    have hlo : -δ ≤ -(i : ℝ) ^ 2 / (alpha : ℝ) := by
