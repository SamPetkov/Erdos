      unfold fourMeanY fourFirstY fourPartY; norm_num
    have hTlo : fourMeanY (1 / 4) ≤ T := by linarith [hbr.1, hTK.1]
    have hThi : T ≤ fourMeanY 32 := by linarith [hbr.2.1, hTK.2]
