  rw [mgf, integral_map_cast_binomial, ← Nat.range_succ_eq_Iic]
  rw [add_pow]
  apply Finset.sum_congr rfl
  intro k hk
  have hexp : Real.exp (t * (k : ℝ)) = Real.exp t ^ k := by
    rw [mul_comm, Real.exp_nat_mul]
  simp only [id_eq, smul_eq_mul]
  rw [hexp]
  ring

