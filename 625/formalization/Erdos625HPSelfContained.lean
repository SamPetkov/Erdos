    linarith [phaseDelta_nonneg n, haSix]
  have hc_le_n : c ≤ (n : ℝ) := div_le_self hnPos.le hs0_ge1
  have hs_le_2n : s ≤ 2 * (n : ℝ) := hs_hi.trans (mul_le_mul_of_nonneg_left hc_le_n zero_le_two)
  have hs_ge_div : (n : ℝ) / (8 * logOrder n) ≤ s := by
