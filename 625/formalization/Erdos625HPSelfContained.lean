    profileLogFactorialSum k = 0 := by
  simp [profileLogFactorialSum]

@[simp] theorem profileFactorialEntropyMain_empty (k : Fin 0 → ℕ) :
    profileFactorialEntropyMain k = 0 := by
  simp [profileFactorialEntropyMain]

