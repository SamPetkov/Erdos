  refine ⟨?_, ?_⟩
  · refine ⟨profileDualOptimizer (b := b) parts t,
      profileDualOptimizer_isFeasible hb hparts hmass, ?_⟩
    exact profileRealObjective_profileDualOptimizer_eq_profileDualUpper
