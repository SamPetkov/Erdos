          Real.exp (Real.log 3 * ((m : ℝ) * (1 / 4))) =
            Real.exp (Real.log 3 * (1 / 4)) ^ m := by
        rw [← Real.exp_nat_mul]
        congr 1
        ring
      rw [hexp_m, mul_pow]

