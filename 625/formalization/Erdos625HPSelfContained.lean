        fourDeficit i := by
    rw [Fin.val_rev, Fin.val_succ]
    change
      alpha - (alpha + 1 - (fourDeficit i + 1 + 1) + 1) =
        fourDeficit i
    omega
  rw [profileDeficitResidualScore_eq_descFactorial alpha _ hsize, hsub]
