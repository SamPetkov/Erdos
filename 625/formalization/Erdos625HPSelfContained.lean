      _ = r₁ * (H₁ - H₂) - r₀ * Δ_main - (S' - S₀) * main_term := by
          rw [hlin_eq, hS₀_mul_main]
      _ = (r₁ - r₀) * Δ_main + r₁ * ((H₁ - H₂) - Δ_main) - (S' - S₀) * main_term := by ring
  have hterm1 : |(r₁ - r₀) * Δ_main| ≤ (4 + C) * B_H * ((n : ℝ) * w / L ^ 2) := by
