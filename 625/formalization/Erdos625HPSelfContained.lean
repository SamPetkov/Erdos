  have hnc : (n : ℝ) = c * s0 := by
    dsimp [c, s0]; unfold phaseRootCenter; exact (div_mul_cancel₀ _ hs0Pos.ne').symm
  have hdiff_s0 : (n : ℝ) / s - s0 = s0 * (c - s) / s := by rw [hnc]; field_simp [hs_pos.ne']
