      (h := fun y : (Fin 4 → ℝ) × K ↦ y.1) x.1
      (T' := fun y ↦ y.2.1)
      (fun i ↦ ((continuous_apply i).comp continuous_fst).continuousAt)
      ((continuous_subtype_val.comp continuous_snd).continuousAt)
      (hKinterior x.2.2)
