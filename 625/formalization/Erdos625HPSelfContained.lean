theorem sum_independentIndicator_measure {n : ℕ}
    (S : Finset (Fin n)) :
    (∑ G : LabeledGraph n,
      independentIndicator G S * randomGraphMeasure n {G}) =
      randomGraphMeasure n (independentEvent S) := by
