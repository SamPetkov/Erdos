    have hlog2_le1 : Real.log 2 ≤ 1 := by linarith [Real.log_two_lt_d9]
    have h2q_ell : (2 / q - 3 / 2) * ell ≤ (29 / 10 - 3 / 2 : ℝ) * ell :=
