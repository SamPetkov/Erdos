                                    (i : ℝ) * Real.log (phaseNat n : ℝ) -
                                    Real.log 2 / 2 * (i : ℝ) ^ 2))) -
                              l * ((fourSizeTarget n (phaseNat n) s - theta₁) / (1 - theta₁))))) +
                        tau₁)
