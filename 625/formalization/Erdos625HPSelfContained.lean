    {Cell Deficit : Type*}
    [Fintype Cell] [Fintype Deficit] [DecidableEq Deficit]
    (allowed : Cell → Finset Deficit)
    (weight : Cell → Deficit → ENNReal)
    (rho : ENNReal)
