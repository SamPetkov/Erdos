      unfold phaseTarget; unfold deltaStar at hδ_0ds; linarith only [hδ_0ds.2, h2lo]
    obtain ⟨-, hmono_cap_δ, -, -⟩ := cappedDualValue_Sge1_concave_strictMono_and_eq_dualValue hTδ_gt2
    have hcap_ge :
        0 ≤ cappedDualValue Sge1 θBar_j (phaseTarget δ) -
