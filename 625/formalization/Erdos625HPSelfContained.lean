  {G | ∀ S : Finset (Fin n), G.IsIndepSet (S : Set (Fin n)) → S.card ∈ U_sizes →
    (Q.parts.filter fun E ↦ (S ∩ E).Nonempty).card = 2 →
      ∃ E ∈ Q.parts, (S ∩ E).card = S.card - 1}

