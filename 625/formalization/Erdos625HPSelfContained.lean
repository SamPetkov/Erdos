  have hgeometric :
      (∑ ell ∈ Finset.range L, rho ^ (ell + 1)) ≤
        rho * (1 - rho)⁻¹ := by
    calc
      (∑ ell ∈ Finset.range L, rho ^ (ell + 1)) ≤
