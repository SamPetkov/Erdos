    have hδ_0ds : δ ∈ Set.Icc (0 : ℝ) deltaStar :=
      ⟨by linarith only [hδ_ds.1, ha₁.1], hδ_ds.2⟩
    have hdist_bar : dist (a_hi + h) δ < r_uth := by
