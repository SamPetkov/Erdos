            S.card ≤ phaseNat n →
            (P.parts.filter fun E ↦ (S ∩ E).Nonempty).card ≤ 2 ∨
              S.card ≤ (P.parts.filter fun E ↦ (S ∩ E).Nonempty).card +
                2 * (phaseNat n - S.card) + 1}
