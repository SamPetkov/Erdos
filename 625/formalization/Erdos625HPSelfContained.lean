        have hq_i : (Real.log 2 / 2) * ((m + 1 + j.1 : ℕ) : ℝ) ^ 2 ≤ 1 * ((1 + M : ℕ) : ℝ) ^ 2 :=
          mul_le_mul (by linarith [Real.log_two_lt_d9]) hsq (sq_nonneg _) zero_le_one
        have hq_nn : 0 ≤ (Real.log 2 / 2) * ((m + 1 + j.1 : ℕ) : ℝ) ^ 2 :=
