  subst hDk
  have hMv : M = a * L - Dl := by linarith
  subst hMv
  have hden : a - (a * Kr - Nr) / Kr = Nr / Kr := by
    field_simp
    ring
  rw [hden, div_div_eq_mul_div]
  field_simp
  ring

