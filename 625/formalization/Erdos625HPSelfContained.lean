    have hunder_pos : 0 < θUnder_j := lt_trans (mul_pos (half_pos hq_pos) hlo_ioc.1) hu_lo
    refine ⟨⟨hbar_pos, by linarith only [hb_hi]⟩, ⟨hunder_pos, hu_hi.le⟩, fun δ hδ ↦ ?_⟩
    have hδ_mesh : δ ∈ Set.Icc a₁ (criticalPhaseX0 - δ₀) :=
