    {X : Omega → ℝ} {b v Lambda : ℝ}
    (hXMeasurable : Measurable X) (hXIntegrable : Integrable X mu)
    (hBound : ∀ᵐ omega ∂mu, X omega ≤ b) (hv : 0 < v) (hLambda : 0 ≤ Lambda)
