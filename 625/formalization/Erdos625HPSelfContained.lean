      simp only [Nat.cast_mul]
    _ = ((W : ℝ≥0∞) * (R : ℝ≥0∞)) /
        ((m.descFactorial J : ℝ≥0∞) * ((m - J).factorial : ℝ≥0∞)) := by
      rw [hfactorialENNReal]
    _ = ((W : ℝ≥0∞) / (m.descFactorial J : ℝ≥0∞)) *
        ((R : ℝ≥0∞) / ((m - J).factorial : ℝ≥0∞)) := by
      exact ENNReal.mul_div_mul_comm
        (a := (W : ℝ≥0∞)) (b := (R : ℝ≥0∞))
        (c := (m.descFactorial J : ℝ≥0∞))
