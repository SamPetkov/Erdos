theorem artanh_partial_le {u : ℝ} (hu0 : 0 ≤ u) (hu1 : u < 1) (N : ℕ) :
    ∑ j ∈ Finset.range N, 2 * (1 / (2 * (j : ℝ) + 1)) * u ^ (2 * j + 1) ≤
      Real.log ((1 + u) / (1 - u)) := by
