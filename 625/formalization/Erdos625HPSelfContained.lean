    fun a b stub ↦
      sigmaSecondCast (matching ⟨a, stub.1⟩) (hlabel a b stub)
  let columnEmbedding : ∀ a b, ↑(selected a b) ↪ Fin (col b) :=
    fun a b ↦
      { toFun := columnValue a b
        inj' := by
          intro x y hxy
          apply Subtype.ext
          have hmatched :
              matching ⟨a, x.1⟩ = matching ⟨a, y.1⟩ := by
