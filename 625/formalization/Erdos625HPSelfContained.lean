      fourDeficitScore alpha i := by
  have hsize :
      (Fin.rev ((⟨fourDeficit i, h⟩ : Fin alpha).succ)).1 + 1 ≤ alpha := by
    rw [Fin.val_rev, Fin.val_succ]
    omega
  have hsub :
