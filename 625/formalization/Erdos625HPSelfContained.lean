/-! ## Exact inversion on the open support interval -/

theorem exists_profileDualMean_eq_of_mem_Ioo {b : ℕ} (hb : 2 ≤ b)
    {target : ℝ} (htarget : target ∈ Set.Ioo 1 (b : ℝ)) :
