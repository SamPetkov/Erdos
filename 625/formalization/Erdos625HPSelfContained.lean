  obtain ⟨Ntilt, hNtilt⟩ := eventually_atTop.1 huniformTilt
  set K_E : ℝ := ((1 + M : ℕ) : ℝ) ^ 2 + 2 * C * universalDualLip
  set B_F0 : ℝ := |Real.log (partitionFn Splus 0)| +
    |min (dualValue S4 (17 / 8)) (dualValue S4 (37 / 8))| + Real.log 2 + 1
