  -- Uniform bound on the shift `|s * (tau - F_{n,S_+} + F_{n,S_5})| ≤ 2 * s0 * Gbound`
  have hShiftBound : ∀ s ∈ Icc (s0 - Delta) (s0 + Delta),
      |s * (tau - finiteUnrestrictedDeficitEntropy (phaseNat n) (fourSizeTarget n (phaseNat n) s) +
