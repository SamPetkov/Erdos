def boundaryShift (delta : ℝ) : ℕ := by
  classical
  exact if delta < deltaStar then 1 else 0

/-- Shifted phase `δ̃ = δ + 1_{δ < 7/200}`. -/
def shiftedPhase (delta : ℝ) : ℝ :=
