    (Q.parts.filter fun E ↦ (S ∩ E).Nonempty).card ≤ 2 ∨
      S.card ≤ (Q.parts.filter fun E ↦ (S ∩ E).Nonempty).card + 2 * (α - S.card) + 1}

private def lemma71_C_ind {n : ℕ} (U_sizes : Set ℕ) (Q : VertexPartition n) :
