  have e2 : |cappedInfiniteFiniteEntropy (phaseNat n) thetaBar T -
      cappedDualValue Sge1 thetaBar T| ≤ C_dual * ell / L := hd_th.trans hcd_le
  change cappedInfiniteFiniteEntropy (phaseNat n) p_1 T -
