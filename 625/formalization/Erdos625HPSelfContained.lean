theorem log_6681_div_4375_eq :
    Real.log (6681 / 4375) = Real.log (153 / 100) - Real.log (525 / 524) := by
  rw [show (6681 / 4375 : ℝ) = (153 / 100) / (525 / 524) by norm_num]
