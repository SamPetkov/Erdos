          2 * ((eps / 2) * (randomGraphMeasure n).real (partitionColoringEvent P)) := by ring
    linarith [hBad_ind_prob, hring]
  have hflip_ind : ∀ (σ : P.parts → Bool) (G : LabeledGraph n),
