    h3R_ev,
    eventually_seed_beats_quasiExpTail_v13 hc₀_pos C_sm] with
    n hn4 hL1 halpha_n ⟨hcZ2, hcZ3⟩ hSel h72 hSim h71 h3R ⟨hn2, ht_nn, h2t, hexp_le, hstrict⟩
