theorem eventually_prop73_and_cor81_upperTails_regimeC
    {M : ℕ} (hM : 8 ≤ M)
    {p1Bar : ℝ} (hp1 : p1Bar ∈ Set.Ioc (0 : ℝ) (1 / 40))
