    (M : ℕ) (C : ℝ) (hC : 0 ≤ C) :
    ∃ K_sep : ℝ, 0 < K_sep ∧ ∀ᶠ n : ℕ in atTop,
      (∀ (m₁ m₂ M₁ M₂ : ℕ), m₁ ≤ 1 → m₂ ≤ 1 → 7 ≤ M₁ → M₁ ≤ M → 7 ≤ M₂ → M₂ ≤ M →
        ∀ tau₁ ∈ Set.Icc (0 : ℝ) (Real.log 2),
          ∀ tau₂ ∈ Set.Icc (0 : ℝ) (Real.log 2),
            let S₁ : Set ℤ := {j : ℤ | ((m₁ + 1 : ℕ) : ℤ) ≤ j ∧ j ≤ ((m₁ + M₁ : ℕ) : ℤ)}
