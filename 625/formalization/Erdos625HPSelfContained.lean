explicitly permitted. -/
def IsFeasible (p : Fin 4 → ℝ) (T : ℝ) : Prop :=
  (∀ i, 0 ≤ p i) ∧
    (∑ i : Fin 4, p i = 1) ∧
      (∑ i : Fin 4, p i * support i = T)

