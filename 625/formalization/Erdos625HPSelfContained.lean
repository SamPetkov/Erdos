namespace Erdos625

open scoped BigOperators

noncomputable section

section MuMonotonicity

/-- For a fixed block size, `mu(v,s)` is nondecreasing in the number of
available vertices. -/
theorem mu_le_of_le_vertex_count {s v w : Nat}
    (_hsv : s <= v) (hvw : v <= w) :
