  let Bad_ind : Set (LabeledGraph n) :=
    (lemma71_B_ind (phaseNat n) U_s P)ᶜ ∪ (lemma71_C_ind U_s P)ᶜ ∪ (lemma71_D_ind U_s P c_half)ᶜ
  have hBad_ind_prob :
      (randomGraphMeasure n).real (partitionColoringEvent P ∩ Bad_ind) ≤
