def matchingDemandCellDecorationEquivPhysicalFibre
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    (demand : A → B → Nat) (row : A → Nat) (col : B → Nat)
    (hmatching : IsBipartiteMatching (positiveDemandSupport demand)) :
