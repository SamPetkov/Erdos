          mul_le_mul_of_nonneg_left hc_hi (by norm_num)
      _ ≤ (n : ℝ) / Real.log (n : ℝ) := by
          have : (0 : ℝ) ≤ (n : ℝ) / Real.log (n : ℝ) := by positivity
          linarith [show (6 / 5 : ℝ) * ((2 / 5 : ℝ) * (n : ℝ) / Real.log (n : ℝ)) =
