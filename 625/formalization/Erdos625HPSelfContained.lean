      · refine Or.inl (Or.inr fun hCf ↦ hnC fun S hS hu hz ↦ hCf S (hind_mono S hS) hu hz)
      · refine Or.inr fun hDf ↦ hnD ?_
        dsimp only [lemma71_D_ind, Set.mem_setOf_eq] at hDf ⊢
