          simp_all +decide [mul_add, add_mul, mul_assoc]
        exact le_add_of_le_of_nonneg
          (mul_le_mul_of_nonneg_left
            (by
              rw [← div_eq_mul_inv]
              rw [le_div_iff₀
                (by
                  exact pow_pos
                    (Real.log_pos
                      (Nat.one_lt_cast.mpr (by linarith))) _) ]
              nlinarith)
            hC)
          (by positivity)

