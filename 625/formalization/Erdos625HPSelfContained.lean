                        profileDeficitAffineB (phaseNat n) * fourSizeTarget n (phaseNat n) s +
                        (binEntropy theta₁ - Real.log 2 / 2 * theta₁ +
                          (1 - theta₁) * (⨅ l : ℝ,
                            (Real.log (∑ i ∈ Finset.Icc 2 M₁,
                                Real.exp (l * (i : ℝ) +
                                  (Real.log ((phaseNat n).descFactorial i : ℝ) -
                                    (i : ℝ) * Real.log (phaseNat n : ℝ) -
