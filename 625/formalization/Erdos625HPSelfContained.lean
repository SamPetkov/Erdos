  have hw_half : (w : ℝ) / 2 ≤ (29 / 20 : ℝ) * Real.log (n : ℝ) * ((∑ i, h i : ℕ) : ℝ) := by
    have hH_nn : 0 ≤ ((∑ i, h i : ℕ) : ℝ) := Nat.cast_nonneg _
    have h1 : (w : ℝ) ≤ (289 / 100 : ℝ) * Real.log (n : ℝ) * ((∑ i, h i : ℕ) : ℝ) :=
