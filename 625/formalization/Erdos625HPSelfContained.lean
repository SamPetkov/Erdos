      have hp_def : p1Inf δ = gibbsProb Sge1 (sge1Tilt (phaseTarget δ)) 1 := rfl
      have hbar_le_opt : θBar_j ≤ gibbsProb Sge1 (sge1Tilt (phaseTarget δ)) 1 := by
