          rw [Real.logb]
          field_simp [hn_pos.ne', hL_pos.ne', hq3_pos.ne']
        have hscale_pos : 0 < (Real.log 2) ^ 3 * ((n : ℝ) / (Real.log (n : ℝ)) ^ 3) := by
          positivity
