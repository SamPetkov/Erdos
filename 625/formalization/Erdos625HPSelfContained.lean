            ∀ theta₂ ∈ Set.Icc (0 : ℝ) (1 / 20),
              ∀ tau₁ ∈ Set.Icc (0 : ℝ) (Real.log 2),
                ∀ tau₂ ∈ Set.Icc (0 : ℝ) (Real.log 2),
                  let obj₁ : ℝ → ℝ := fun s ↦
                    (n : ℝ) * Real.log (n : ℝ) - (n : ℝ) + s - s * Real.log s +
