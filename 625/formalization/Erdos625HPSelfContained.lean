  intro stub hstub
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  have hpair :=
    (extendsPrescribedDemandWitness_iff_cellwise matching witness).1
      hextends a b ⟨stub, hstub⟩
  exact congrArg Sigma.fst hpair

