    dsimp [g, c_const, m_slope, a]
    unfold fourSizeTarget
    calc (n : ℝ) * Real.log (n : ℝ) - (n : ℝ) + (l - profileDeficitAffineB (phaseNat n)) * (n : ℝ) +
