  obtain ⟨hp_pert_at_lim, hm_pert_at_lim⟩ :=
    wProb_and_wMean_perturbation_v13 hW_ne hδ0 hδ_hi hsc_diff l_lim
  have hmean_diff : |wMean_v13 W h_sc l_lim - wMean_v13 W h_sc l_fin| ≤
