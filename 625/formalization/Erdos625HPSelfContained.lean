      ¬ Disjoint C M ↔ (C ∩ M).Nonempty := by
    constructor
    · intro h
      rw [Finset.disjoint_left] at h
      push Not at h
      obtain ⟨e, heC, heM⟩ := h
      exact ⟨e, Finset.mem_inter.mpr ⟨heC, heM⟩⟩
