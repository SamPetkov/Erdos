usual expression `m * log m - m`. -/
noncomputable def factorialEntropyMain (m : ℕ) : ℝ :=
  if m = 0 then 0 else (m : ℝ) * Real.log (m : ℝ) - m

/-- A coarse explicit error that is uniform at zero and grows only
logarithmically. -/
