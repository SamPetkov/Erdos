            phaseNat n - (M + 1) ≤ S.card →
            S.card ≤ phaseNat n →
            (P.parts.filter fun B ↦ (S ∩ B).Nonempty).card = 2 →
            ∃ B ∈ P.parts, (S ∩ B).card = S.card - 1}
