      intro B
      by_cases hcl : G.IsClique (B.1 : Set (Fin n))
      · simp [hcl]
      · simp only [hcl, decide_false, Bool.false_eq_true, ↓reduceIte]
        exact (hGco B.1 B.2).resolve_right hcl
    calc (randomGraphMeasure n).real (partitionCocoloringEvent P ∩ Bad_ind)
