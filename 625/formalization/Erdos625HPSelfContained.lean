  let P : A → B → Prop := fun a b => M a b ∨ 2 ≤ cellCount a b
  refine
    { toFun := fun F => ⟨supportedCellFinsetToEdges P F.1,
        (supportedCellFinsetToEdges_even_iff P F.1 F.2.2).mp F.2.1⟩
      invFun := fun E => ⟨supportedEdgesToCellFinset P E.1, ?_, ?_⟩
