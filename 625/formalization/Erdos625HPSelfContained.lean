  · simp [factorialEntropyMain]
  · have hm : 0 < m + 1 := Nat.succ_pos m
    have hR := stirlingLogRemainder_nonneg hm
    have hLogM : 0 ≤ Real.log ((m + 1 : ℕ) : ℝ) := by
      exact Real.log_nonneg (by exact_mod_cast hm)
