          · rw [htop]
            have hcast : ((N_mesh - 1 : ℕ) : ℝ) = (N_mesh : ℝ) - 1 := by
              rw [Nat.cast_sub hN_mesh_ge1, Nat.cast_one]
            dsimp only
            rw [hcast]
            linarith only [hh_mul, hh_pos]
          · rw [htop]
            dsimp only
            rw [Nat.sub_add_cancel hN_mesh_ge1]
            linarith only [hh_mul]
