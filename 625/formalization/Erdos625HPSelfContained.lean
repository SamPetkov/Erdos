  -- Mean-value lower bound `c_star * |l_fin - l_lim| ≤ |M_fin l_fin - M_fin l_lim|`
  have hl_diff_le : |l_fin - l_lim| ≤ C_tilt / (alpha : ℝ) := by
    have hmvt_step : ∀ {a b : ℝ}, a ∈ Set.Icc (-Λ_M) Λ_M → b ∈ Set.Icc (-Λ_M) Λ_M → a ≤ b →
