    simpa only [Function.comp_def, id_eq] using
      (isLittleO_const_id_atTop (50 / 7 : ℝ)).comp_tendsto
        tendsto_logOrder_atTop
  have hConstK :
      (fun _n : ℕ ↦ (50 / 7 : ℝ)) =o[atTop]
        (fun n : ℕ ↦ (K n : ℝ)) :=
    hConstLog.trans hK
