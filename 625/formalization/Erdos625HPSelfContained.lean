    (1 : ℝ) < profileClassSize i := by
  have hpos : 0 < i.1 := by
    by_contra hnot
    have hzero : i.1 = 0 := by omega
    apply hi
    apply Fin.ext
    simp [profileDualFirstIndex, hzero]
