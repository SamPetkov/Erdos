    by_cases h1 : δ ≤ a₁
    · exact Or.inl ⟨hδ.1, h1⟩
    · replace h1 : a₁ < δ := lt_of_not_ge h1
      by_cases h2 : δ ≤ criticalPhaseX0 - δ₀
      · right; left
        by_cases htop : δ = criticalPhaseX0 - δ₀
