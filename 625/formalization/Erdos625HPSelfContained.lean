    simpa using E.2
    intro e he
    change e ∈ ((E.1.map
      (supportedCellEquivBipartiteGraphEdge P).symm.toEmbedding).map
        (Function.Embedding.subtype _)) at he
    rw [Finset.mem_map] at he
