    have hhalf : (n : ℝ) / 2 ≤ ((n - a : ℕ) : ℝ) := by
      rw [Nat.cast_sub ha_le]
      have : 2 * (a : ℝ) ≤ (n : ℝ) := by exact_mod_cast (show 2 * a ≤ n by omega)
