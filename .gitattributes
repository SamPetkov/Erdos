# Keep checksum-referenced publication text byte-stable across platforms.
.gitattributes text eol=lf
.gitignore text eol=lf
README.md text eol=lf
CITATION.cff text eol=lf
LICENSE text eol=lf
LICENSE_SCOPE.md text eol=lf
625/*.md text eol=lf
625/**/*.md text eol=lf
625/**/*.py text eol=lf
625/**/*.lean text eol=lf
625/**/*.tex text eol=lf
625/**/*.bib text eol=lf
625/**/*.bbl text eol=lf
625/**/lakefile.toml text eol=lf
625/**/lake-manifest.json text eol=lf
625/**/lean-toolchain text eol=lf
.github/workflows/*.yml text eol=lf
625/assets/animations/*.json text eol=lf
625/assets/animations/*.md text eol=lf

# Never apply text conversions to publication binaries.
*.pdf binary
*.png binary
*.zip binary
*.gif binary
*.mp4 binary
